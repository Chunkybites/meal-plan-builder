# Food-data engine — environment variables
# Copy to `.env` and fill in. NEVER commit real keys. The FDC key is used ONLY by
# the server-side proxy; it must never be exposed to client-side code.

# --- USDA FoodData Central (server-side proxy only) ---
# Obtain a free key at https://fdc.nal.usda.gov/api-key-signup.html
# Rate limit: 1,000 requests/hour with a real key (DEMO_KEY is 30/hour, 50/day).
FDC_API_KEY=your-fdc-api-key-here

# Base URL the browser calls for the FDC proxy (the proxy injects FDC_API_KEY).
# Leave as the default relative path when the proxy is hosted alongside the app.
VITE_FDC_PROXY_BASE=/api/fdc

# --- Open Food Facts (runtime, no key) ---
# OFF requires an identifying User-Agent: "AppName/Version (contact email)".
# Browsers cannot override the User-Agent header, so for strict compliance proxy
# OFF server-side in production and set this there.
OFF_USER_AGENT=FuelKitchenMealPlanner/1.0 (contact: you@example.com)

# --- Beta deployment (all optional; safe to expose — VITE_ vars are PUBLIC) ---
# Simple beta access gate. If set, visitors must enter this code once before using
# the app. This is a low-friction screen for a controlled beta, NOT real security
# (the value is visible in the client bundle). Leave unset to disable the gate.
VITE_BETA_CODE=

# Feedback destination. Create a free form endpoint (e.g. https://formspree.io —
# it gives you a URL like https://formspree.io/f/abcdwxyz) and paste it here.
# Tester feedback and throttled auto-error reports POST to this endpoint.
VITE_FEEDBACK_ENDPOINT=

# Fallback shown in the feedback dialog when no endpoint is configured.
VITE_FEEDBACK_EMAIL=

# The dev-only recipe-authoring tool (#authoring) is disabled in production
# builds unless this is set to "true". Leave unset for beta deployments.
VITE_ENABLE_AUTHORING=
