{
  "name": "meal-plan-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate-evidence": "npx --yes tsx scripts/validate.ts",
    "validate-food": "npx --yes tsx scripts/validate-food-data.ts",
    "import-cofid": "npx --yes tsx scripts/import-cofid.ts",
    "extract-recipe-foods": "npx --yes tsx scripts/extract-recipe-foods.ts",
    "migrate-recipes": "npx --yes tsx scripts/migrate-recipes.ts",
    "validate-recipes": "npx --yes tsx scripts/validate-recipes.ts",
    "coverage-matrix": "npx --yes tsx scripts/coverage-matrix.ts",
    "find-food": "npx --yes tsx scripts/find-food.ts",
    "link-recipes": "npx --yes tsx scripts/link-recipes.ts"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  }
}
